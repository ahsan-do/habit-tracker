{
  "expo": {
    "name": "Steadily",
    "slug": "steadily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/steadily-icon.png",
    "scheme": "steadily",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.steadily"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/steadily-adaptive-icon.png",
        "backgroundColor": "#6C5CE7"
      },
      "package": "com.anonymous.steadily"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/steadily-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6C5CE7"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37bb6c54-cd47-4073-a9c4-3b52bf09b5bb"
      }
    },
    "owner": "ahsan1999"
  }
}
